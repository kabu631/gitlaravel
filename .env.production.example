# Production environment template for Git Infosys.
#
# Copy this file to .env on the server, fill in every CHANGE_ME, set APP_URL to
# your real https:// domain and follow DEPLOYMENT.md. Generate APP_KEY on the
# server; never reuse a key that has been in Git.

APP_NAME="Git Infosys"
APP_ENV=production
# Generate your own on the server: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=git_infosys_v2
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over HTTPS in production
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="info@gitinfosys.com.np"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Features — get a free key at https://openrouter.ai/keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=

# Secure Admin Path — pre-generated so it isn't the well-known "secure-admin".
# Your admin panel will live at https://your-domain.com/gi-panel-ea211757fbb8
# Change it to your own random string any time (deploy note: run
# `php artisan config:clear` after changing it if config was cached).
# Your own admin address: pick something hard to guess.
FILAMENT_PATH=CHANGE_ME

# Only behind Cloudflare or a load balancer: its IPs, or * when all traffic comes through it.
TRUSTED_PROXIES=
